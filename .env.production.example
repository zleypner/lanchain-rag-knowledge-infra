# ===========================================
# LangChain RAG Knowledge Infrastructure
# Production Environment Configuration
# ===========================================
# Copy this file to .env.production and fill in your values
# IMPORTANT: Never commit production secrets to version control

# -----------------
# LLM Configuration
# -----------------
OPENAI_API_KEY=sk-your-production-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------
# Application Settings
# -----------------
ENVIRONMENT=production
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=WARNING

# -----------------
# Security - CORS
# -----------------
# Restrict to your production domains only
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# -----------------
# Database Configuration
# -----------------
# Use strong passwords in production
POSTGRES_USER=rag_app
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=rag_knowledge
POSTGRES_PORT=5432

# Connection URLs (update host for Docker networking)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Connection pool (adjust based on expected load)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# -----------------
# Vector Store
# -----------------
VECTOR_STORE_TYPE=pgvector
PGVECTOR_COLLECTION=document_embeddings
EMBEDDING_DIMENSIONS=1536

# -----------------
# File Upload
# -----------------
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.docx

# -----------------
# RAG Configuration
# -----------------
RETRIEVAL_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# -----------------
# Rate Limiting
# -----------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# -----------------
# Docker Ports
# -----------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# -----------------
# Frontend
# -----------------
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# -----------------
# Optional: Redis (for caching/rate limiting)
# -----------------
# REDIS_URL=redis://redis:6379/0

# -----------------
# Optional: Monitoring
# -----------------
# SENTRY_DSN=https://your-sentry-dsn
# PROMETHEUS_ENABLED=true
