# ===========================================
# LangChain RAG Knowledge Infrastructure
# Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Never commit .env to version control

# -----------------
# LLM Configuration
# -----------------

# OpenAI API Key (required for OpenAI models)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model to use for chat completions
OPENAI_MODEL=gpt-4o-mini

# OpenAI Embedding Model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------
# Ollama Configuration (optional - for local development)
# -----------------

# Ollama base URL (if using local Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name
OLLAMA_MODEL=llama3.2

# Ollama embedding model
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# -----------------
# Application Settings
# -----------------

# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (true/false)
DEBUG=true

# API host and port
API_HOST=0.0.0.0
API_PORT=8000

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------
# File Upload Settings
# -----------------

# Directory for uploaded files
UPLOAD_DIR=./data/uploads

# Maximum upload size in MB
MAX_UPLOAD_SIZE_MB=10

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.docx

# -----------------
# Vector Store Settings
# -----------------

# Vector store type: faiss, pgvector
VECTOR_STORE_TYPE=faiss

# FAISS index path (for local development)
FAISS_INDEX_PATH=./data/faiss_index

# -----------------
# Database Configuration
# -----------------

# PostgreSQL connection URL (async driver for application)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_knowledge

# PostgreSQL connection URL (sync driver for Alembic migrations)
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/rag_knowledge

# Database connection pool settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# PGVector collection name
PGVECTOR_COLLECTION=document_embeddings

# Embedding dimensions (must match your embedding model)
EMBEDDING_DIMENSIONS=1536

# -----------------
# Redis Configuration (optional)
# -----------------

# Redis URL for caching and task queue
# REDIS_URL=redis://localhost:6379/0

# -----------------
# RAG Configuration
# -----------------

# Number of chunks to retrieve
RETRIEVAL_K=4

# Chunk size for text splitting
CHUNK_SIZE=1000

# Chunk overlap
CHUNK_OVERLAP=200

# -----------------
# Logging
# -----------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
